      "name": "date_parse_edge",
      "sql": "SELECT date_parse('2024-02-29 13', '%Y-%m-%d %H'), date_parse('1 2 2024', '%e %c %Y'), date_parse('00:00:00', '%T'), date_parse('2024-366', '%Y-%j')",
