          ]
        ]
      }
    },
    {
      "name": "parse_datetime_edge",
      "sql": "SELECT parse_datetime('2024-02-29 10:11:12.345 America/Sao_Paulo', 'yyyy-MM-dd HH:mm:ss.SSS ZZZ'), parse_datetime(CAST(NULL AS varchar), 'yyyy'), parse_datetime('2024-2-9', 'yyyy-M-d')",
      "trino": {
        "types": [
          "timestamp(3) with time zone",
          "timestamp(3) with time zone",
          "timestamp(3) with time zone"
        ],
        "rows": [
